# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB)
MONGO_URI=mongodb://localhost:27017/fluxboard

# Authentication & JWT Secrets (Change these in production!)
JWT_SECRET=your_super_secret_jwt_access_token_key_change_me
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_token_key_change_me

# Client Application URL for CORS & Socket.io
CLIENT_URL=http://localhost:5173
